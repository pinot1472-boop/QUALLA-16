# Copia estas variables en Railway -> tu servicio -> Variables. (No subas claves a GitHub.)

# ---- obligatorias
BINGX_API_KEY=
BINGX_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- operar (empieza con false: solo señales a Telegram)
AUTO_TRADE=false
LEVERAGE=5
MARGIN_MODE=ISOLATED
RISK_PCT=1.0
MAX_OPEN_POSITIONS=3
MAX_TRADES_PER_DAY=8
DAILY_LOSS_LIMIT_PCT=4
TP_R=3.0

# ---- escáner
TIMEFRAME=15m
MIN_QUOTE_VOL_USDT=3000000
MIN_SCORE=62
ALERT_SCORE=72
TRADE_SCORE=70
SCAN_INTERVAL_SEC=300

# ---- opcionales
# BINGX_DEMO=true            # cuenta demo VST de BingX
# POSITION_MODE=auto         # auto | hedge | oneway
# TELEGRAM_COMMANDS=true     # /status /top /pause /resume (usa un bot de Telegram dedicado)
# STATE_FILE=/data/state.json   # si montas un volumen en Railway
# EXCLUDE_SYMBOLS=BTC,ETH    # monedas a ignorar
# INCLUDE_TRADFI=false       # acciones/materias primas/forex de BingX
